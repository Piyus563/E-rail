DJANGO_SECRET_KEY=replace-me-with-a-strong-50-char-random-secret
DJANGO_DEBUG=True

# Allowed hosts (comma-separated) — required in production when DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Public site URL for links in WhatsApp notifications
SITE_URL=http://127.0.0.1:8000

# CORS allowed origins (comma-separated) — locks down CORS in production
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# PostgreSQL connection URL (leave unset to use local SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/railsaathi

# Twilio WhatsApp Credentials — get from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Legacy PostgreSQL settings (DATABASE_URL is preferred)
# DB_ENGINE=postgres
# POSTGRES_DB=railsaathi
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
